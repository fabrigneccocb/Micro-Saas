# Copia este archivo a .env.local y llena cada valor.
# El manual paso a paso de dónde sacar cada uno está en /docs/DESPLIEGUE.md

# --- Anthropic (agentes) ---
ANTHROPIC_API_KEY=

# Modelos usados (ver white paper 1.7 / 4.1)
MODEL_CONSULTANTE=claude-haiku-5-5
MODEL_EVALUADOR=claude-sonnet-5-5
MODEL_SEGURIDAD=claude-haiku-5-5
MODEL_GENERADOR_CASOS=claude-sonnet-5-5
MODEL_EMBEDDINGS=voyage-3.5

# Voyage AI (embeddings para RAG; alternativa recomendada por Anthropic)
VOYAGE_API_KEY=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Pasarela de pagos (Wompi) ---
PAYMENT_PUBLIC_KEY=
PAYMENT_PRIVATE_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Negocio ---
PRECIO_MENSUAL_COP=15000
SESIONES_GRATIS_MES=0
REUTILIZACIONES_CASO_PREDETERMINADO=20
